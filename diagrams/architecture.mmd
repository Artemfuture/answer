flowchart LR
    subgraph BG["① Фоновая синхронизация — заранее, каждый час"]
        direction LR
        AMO[("amoCRM API v4<br/>сделки · задачи · этапы")] --> CRM["CRM-агент<br/>инкрементальная выгрузка"]
        TEL[("API телефонии<br/>журнал звонков · записи")] --> CALL["Агент звонков<br/>расшифровка + оценка LLM"]
    end

    subgraph STORE["Хранилище"]
        direction TB
        DB[("PostgreSQL + pgvector<br/>сделки, звонки,<br/>оценки, метрики")]
        S3[("S3<br/>аудиозаписи")]
    end

    CRM --> DB
    CALL --> DB
    CALL --> S3

    subgraph REQ["② По запросу руководителя — ответ из готовой базы"]
