        V -->|нет| R
        V -->|да| OUT["Отчёт в Telegram<br/>со ссылками на<br/>сделки и звонки"]
    end

    DB --> A

    classDef src fill:#e8f1fb,stroke:#3b82c4,color:#1a1a1a
